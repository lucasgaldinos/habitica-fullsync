{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "CommonJS",
    "target": "ES2018",
    "allowJs": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "lib": ["ES6", "DOM"],
    "outDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
